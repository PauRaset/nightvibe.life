# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.

# Formulario de /locales → POST /api/contacto → SendGrid. Sin las tres, el
# formulario responde "No hemos podido enviar tu mensaje" (500) y lo registra.
SENDGRID_API_KEY=      # API key de SendGrid con permiso "Mail Send"
CONTACT_TO_EMAIL=      # a quién llegan las solicitudes (normalmente CONTACT_EMAIL de site.ts)
CONTACT_FROM_EMAIL=    # remitente verificado en SendGrid (Single Sender o dominio autenticado)

# Backend de NightVibe: entradas compartidas en /t/[token]
API_BASE=https://api.nightvibe.life
